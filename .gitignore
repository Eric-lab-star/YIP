# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

.vercel
.env*.local

# Claude Code config. Ignore the directory's contents by default, then share the
# team-wide pieces: hooks, the chapter-conversion agent, slash commands, and the
# permission/hook wiring that makes them run. `settings.local.json` stays out —
# it is personal and has held credentials — as do worktrees and launch.json.
# Note `/.claude/*` rather than `/.claude`: git cannot re-include a path whose
# parent directory is excluded, so the negations below would never apply.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/agents/
!/.claude/commands/

# local connectivity/debug script (contained credentials — do not commit)
test-mongo.mjs

# Self-hosted Monaco assets (copied from node_modules by scripts/copy-monaco.mjs)
/public/monaco/

# 로컬 임시 작업 디렉터리 (dev 로그 등)
scratchpad/

# local-only review doc (not meant to be committed)
AI_COURSE_REVIEW.md
